{
  "name": "wasm.ltd",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wasm/site",
    "build": "npm run build --workspace @wasm/site",
    "storybook": "npm run storybook --workspace @origami-ltd/ui",
    "build-storybook": "npm run build-storybook --workspace @origami-ltd/ui",
    "dev:generals": "npm run dev --workspace @wasm/generals-web",
    "dev:vice": "npm run dev --workspace @wasm/vice-web"
  },
  "devDependencies": {
    "plop": "^4.0.5"
  }
}
