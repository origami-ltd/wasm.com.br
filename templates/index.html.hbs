<!doctype html>
<html lang="en" data-brand="{{brand}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <!-- The port's own name, never the retail title. A brand notice goes after the trademark on
         the page, not after the source port underneath it. -->
    <title>{{title}} — a decompilation running in your browser — wasm.ltd</title>
    <meta name="description" content="{{title}}, the open-source decompilation, compiled to WebAssembly and rendered with {{gpu}} — running entirely in the browser, streaming from a copy you already own. Part of the wasm.ltd game preservation initiative.">
    <link rel="canonical" href="https://{{subdomain}}.wasm.ltd/">
    <!-- Where an automated reader is asked to look. Same file a person can open. -->
    <link rel="license" href="/llms.txt">
    <meta name="theme-color" content="{{themeColor}}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="wasm.ltd">
    <meta property="og:title" content="{{title}} in your browser">
    <meta property="og:description" content="The {{upstreamName}} decompilation compiled to WebAssembly + {{gpu}}. Bring your own installed copy — nothing is downloaded or redistributed.">
    <meta property="og:url" content="https://{{subdomain}}.wasm.ltd/">
    <meta property="og:image" content="https://{{subdomain}}.wasm.ltd/og-{{subdomain}}.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{title}} in your browser">
    <meta name="twitter:description" content="WebAssembly + {{gpu}}. Your own copy, streamed — nothing redistributed.">
    <meta name="twitter:image" content="https://{{subdomain}}.wasm.ltd/og-{{subdomain}}.png">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='{{themeColorEncoded themeColor}}'/%3E%3C/svg%3E">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "{{title}} — wasm.ltd",
      "url": "https://{{subdomain}}.wasm.ltd/",
      "image": "https://{{subdomain}}.wasm.ltd/og-{{subdomain}}.png",
      "description": "The {{upstreamName}} decompilation compiled to WebAssembly, rendering through {{gpu}}. Players stream assets from their own installed copy; no game data is distributed.",
      "applicationCategory": "Game",
      "operatingSystem": "Web browser ({{gpu}}, SharedArrayBuffer)",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "license": "https://github.com/origami-ltd/{{slug}}/blob/main/LICENSE",
      "usageInfo": "https://{{subdomain}}.wasm.ltd/llms.txt",
      "creditText": "A project by Origami 限 · part of wasm.ltd · WebAssembly port by Erasmo \"ebellumat\" Bellumat",
      "isBasedOn": "{{upstreamUrl}}",
      "author": { "@type": "Person", "name": "Erasmo Bellumat", "url": "https://github.com/ebellumat" },
      "publisher": { "@type": "Organization", "name": "Origami 限", "url": "https://origami.ltd" },
      "isPartOf": { "@type": "WebSite", "name": "wasm.ltd", "url": "https://wasm.ltd" }
    }
    </script>
    <!-- Google Analytics: one property for wasm.ltd and every game subdomain -->
    <script async crossorigin="anonymous" src="https://www.googletagmanager.com/gtag/js?id=G-7PS7XPQE5G"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7PS7XPQE5G');
    </script>
    <script type="module" src="/src/main.ts"></script>
</head>
<body class="ogx-body ogx-scanlines">
    <div id="app"></div>
</body>
</html>
